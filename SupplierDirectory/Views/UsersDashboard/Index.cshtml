@model IEnumerable<SupplierDirectory.Application.UserDto>
@{ ViewData["Title"] = "إدارة المستخدمين"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 text-secondary mb-0"><i class="fa-solid fa-users-cog me-2"></i> @ViewData["Title"]</h2>
    <a href="/dashboard/users/create" class="btn btn-primary rounded-pill px-4 shadow-sm">
        <i class="fa-solid fa-plus ms-1"></i> إضافة مستخدم
    </a>
</div>

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">البريد الإلكتروني</th>
                        <th class="text-end pe-4">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-secondary">
                                <i class="fa-solid fa-user-shield text-primary me-2"></i> @item.Email
                            </td>
                            <td class="text-end pe-4">
                                <a href="/dashboard/users/@item.Id/edit" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="fa-solid fa-pen-to-square"></i> تعديل
                                </a>
                                @if(item.Email != "admin@admin.com")
                                {
                                    <form method="post" action="/dashboard/users/@item.Id/delete" class="d-inline" onsubmit="return confirm('هل أنت متأكد من حذف هذا المستخدم؟');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                            <i class="fa-solid fa-trash"></i> حذف
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="2" class="text-center text-muted py-4">لا يوجد مستخدمين لعرضهم</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
