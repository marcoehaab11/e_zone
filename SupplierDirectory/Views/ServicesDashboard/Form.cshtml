@model SupplierDirectory.Application.ServiceFormViewModel
@{
    var isEdit = Model.Id.HasValue && Model.Id > 0;
    ViewData["Title"] = isEdit ? "تعديل الخدمة" : "إضافة خدمة جديدة";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="fa-solid fa-screwdriver-wrench text-primary me-2"></i> @ViewData["Title"]</h3>
        <p class="text-muted small mb-0">@(isEdit ? "تحديث بيانات وصور وتفاصيل الخدمة" : "إدخال خدمة جديدة وعرضها في تطبيق وموقع المنصة")</p>
    </div>
    <a href="/dashboard/services" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm"><i class="fa-solid fa-arrow-right ms-1"></i> رجوع للقائمة</a>
</div>

<form method="post" enctype="multipart/form-data" action="@(isEdit ? $"/dashboard/services/{Model.Id}/edit" : "/dashboard/services/create")">
    @Html.AntiForgeryToken()
    @if (Model.Id.HasValue) { <input type="hidden" asp-for="Id" /> }
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body p-4">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            
            <div class="row">
                <div class="col-md-8 mb-3">
                    <label asp-for="Name" class="form-label fw-bold">اسم الخدمة <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="أدخل اسم الخدمة (مثال: صيانة أجهزة، استشارات فنية، شحن وتوصيل)..." />
                    <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="DisplayOrder" class="form-label fw-bold">ترتيب العرض</label>
                    <input asp-for="DisplayOrder" type="number" class="form-control" placeholder="0" />
                    <span asp-validation-for="DisplayOrder" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>
            
            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-bold">وصف قصير</label>
                <textarea asp-for="Description" class="form-control" rows="2" placeholder="وصف موجز للخدمة يظهر في القوائم والبطاقات..."></textarea>
                <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Details" class="form-label fw-bold">تفاصيل وشرح موسع للخدمة</label>
                <textarea asp-for="Details" class="form-control" rows="5" placeholder="شرح مفصل عن كيفية تقديم الخدمة والمزايا والتفاصيل الفنية (اختياري)..."></textarea>
                <span asp-validation-for="Details" class="text-danger small mt-1 d-block"></span>
            </div>
            
            <div class="form-check form-switch mt-3">
                <input asp-for="IsActive" class="form-check-input border-primary" type="checkbox" role="switch">
                <label asp-for="IsActive" class="form-check-label fw-bold ms-2">الخدمة نشطة وتظهر في المنصة</label>
            </div>
        </div>
    </div>
    
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-header bg-white border-bottom p-3">
            <h5 class="mb-0 fw-bold text-primary"><i class="fa-solid fa-images me-2"></i> صور الخدمة</h5>
        </div>
        <div class="card-body p-4">
            <div class="mb-4">
                <label asp-for="NewImages" class="form-label fw-bold">رفع صور جديدة (يمكنك اختيار صورة واحدة أو أكثر)</label>
                <input type="file" asp-for="NewImages" class="form-control" multiple accept="image/*">
                <div class="form-text">الصيغ المدعومة: JPG, PNG, WEBP (الحجم الأقصى لكل صورة: 5 ميجابايت).</div>
                <span asp-validation-for="NewImages" class="text-danger small mt-1 d-block"></span>
            </div>
            @if (Model.ExistingImages.Any()) {
                <h6 class="fw-bold mb-3">الصور الحالية للخدمة:</h6>
                <div class="row g-3">
                    @foreach(var img in Model.ExistingImages) {
                        <div class="col-6 col-md-3 col-lg-2 text-center" id="img-@img.Id">
                            <div class="position-relative d-inline-block border rounded p-1 shadow-sm">
                                <img src="@img.ImageUrl" class="img-fluid rounded" style="height:100px; width:100px; object-fit:cover;">
                                <button type="button" class="btn btn-danger btn-sm position-absolute top-0 start-0 translate-middle rounded-circle shadow" onclick="deleteImg(@Model.Id, @img.Id)" title="حذف الصورة"><i class="fa-solid fa-xmark"></i></button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
    
    <div class="text-end pb-5">
        <button type="submit" class="btn btn-primary rounded-pill px-5 shadow-sm fw-bold"><i class="fa-solid fa-save ms-1"></i> حفظ الخدمة</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function deleteImg(serviceId, imgId) {
            if(!confirm('هل أنت متأكد من حذف هذه الصورة؟')) return;
            fetch('/dashboard/services/' + serviceId + '/delete-image/' + imgId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value }
            }).then(r => { if(r.ok) document.getElementById('img-' + imgId).remove(); else alert('حدث خطأ أثناء حذف الصورة'); });
        }
    </script>
}
