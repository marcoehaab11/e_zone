@model IEnumerable<SupplierDirectory.Domain.Product>
@{ ViewData["Title"] = "المنتجات"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="fa-solid fa-box-open text-primary me-2"></i> قائمة المنتجات</h3>
        <p class="text-muted small mb-0">إدارة وعرض المنتجات وتصنيفاتها والمناطق التابعة لها</p>
    </div>
    <a href="/dashboard/products/create" class="btn btn-primary rounded-pill px-4 shadow-sm">
        <i class="fa-solid fa-plus ms-1"></i> إضافة منتج جديد
    </a>
</div>

<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <input type="text" name="Search" class="form-control rounded-pill px-4" placeholder="ابحث بالاسم أو الوصف..." value="@ViewBag.Search">
            </div>
            <div class="col-md-3">
                <select name="ProductCategoryId" class="form-select rounded-pill px-4">
                    <option value="">كل تصنيفات المنتجات</option>
                    @foreach(var cat in ViewBag.ProductCategories) {
                        if (ViewBag.ProductCategoryId == cat.Id) { <option value="@cat.Id" selected>@cat.Name</option> }
                        else { <option value="@cat.Id">@cat.Name</option> }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="AreaId" class="form-select rounded-pill px-4">
                    <option value="">كل المناطق</option>
                    @foreach(var area in ViewBag.Areas) {
                        if (ViewBag.AreaId == area.Id) { <option value="@area.Id" selected>@area.Name</option> }
                        else { <option value="@area.Id">@area.Name</option> }
                    }
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-secondary rounded-pill"><i class="fa-solid fa-filter ms-1"></i> تصفية</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 70px;">صورة</th>
                        <th>اسم المنتج</th>
                        <th>تصنيف المنتج</th>
                        <th>المنطقة</th>
                        <th>الحالة</th>
                        <th class="text-end pe-4">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td class="ps-4">
                                @if (item.Images.Any()) {
                                    <img src="@item.Images.OrderBy(i => i.DisplayOrder).First().ImageUrl" class="rounded border shadow-sm" style="width: 48px; height: 48px; object-fit: cover;">
                                } else {
                                    <div class="bg-light rounded border d-flex justify-content-center align-items-center text-muted" style="width: 48px; height: 48px;">
                                        <i class="fa-solid fa-image opacity-50"></i>
                                    </div>
                                }
                            </td>
                            <td><span class="fw-bold text-dark fs-6">@item.Name</span></td>
                            <td>
                                @if (item.ProductCategory != null) {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                        <i class="fa-solid fa-tag me-1"></i>@item.ProductCategory.Name
                                    </span>
                                } else {
                                    <span class="text-muted small">بدون تصنيف</span>
                                }
                            </td>
                            <td><span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">@(item.Area?.Name ?? "عام")</span></td>
                            <td>
                                @if (item.IsActive) { <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i> نشط</span> }
                                else { <span class="badge bg-secondary"><i class="fa-solid fa-xmark me-1"></i> معطل</span> }
                            </td>
                            <td class="text-end pe-4">
                                <a href="/dashboard/products/@item.Id/edit" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="fa-solid fa-pen-to-square"></i> تعديل
                                </a>
                                <form method="post" action="/dashboard/products/@item.Id/delete" class="d-inline" onsubmit="return confirm('هل أنت متأكد من حذف هذا المنتج؟');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                        <i class="fa-solid fa-trash"></i> حذف
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any()) {
                        <tr><td colspan="6" class="text-center text-muted py-5">لا يوجد منتجات مطابقة للبحث</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
