@model SupplierDirectory.Application.ProductCategoryFormViewModel
@{
    var isEdit = Model.Id.HasValue && Model.Id > 0;
    ViewData["Title"] = isEdit ? "تعديل تصنيف المنتج" : "إضافة تصنيف منتج جديد";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">@(isEdit ? "تعديل تصنيف المنتج" : "إضافة تصنيف منتج جديد")</h3>
        <p class="text-muted small mb-0">@(isEdit ? "تحديث بيانات وصورة ومستوى تصنيف المنتج" : "إنشاء تصنيف رئيسي أو فرعي جديد للمنتجات")</p>
    </div>
    <a href="/dashboard/product-categories" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-right ms-1"></i>رجوع للقائمة</a>
</div>

<div class="card border-0 shadow-sm" style="max-width: 650px;">
    <div class="card-body p-4">
        <form method="post" enctype="multipart/form-data" action="@(isEdit ? $"/dashboard/product-categories/{Model.Id}/edit" : "/dashboard/product-categories/create")">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            
            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-bold">اسم تصنيف المنتج <span class="text-danger">*</span></label>
                <input asp-for="Name" class="form-control" placeholder="أدخل اسم التصنيف (مثال: هواتف ذكية، أدوات كهربائية، قطع غيار)...">
                <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ParentCategoryId" class="form-label fw-bold">التصنيف الرئيسي (الأب)</label>
                <select asp-for="ParentCategoryId" class="form-select">
                    <option value="">(مستوى رئيسي - بدون تصنيف أم)</option>
                    @foreach (var p in Model.Parents)
                    {
                        <option value="@p.Id" selected="@(Model.ParentCategoryId == p.Id)">@p.Name</option>
                    }
                </select>
                <div class="form-text">اتركه فارغاً إذا كان هذا تصنيفاً رئيسياً، أو اختر التصنيف الرئيسي الذي يندرج تحته.</div>
                <span asp-validation-for="ParentCategoryId" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-bold">الوصف</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="نبذة توضيحية عن المنتجات التي تندرج تحت هذا التصنيف (اختياري)..."></textarea>
                <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ImageFile" class="form-label fw-bold">صورة / أيقونة التصنيف</label>
                <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" onchange="previewImage(this, 'productCatImgPreview')">
                <div class="form-text">الصيغ المدعومة: JPG, PNG, WEBP (الحجم الأقصى: 5 ميجابايت).</div>
                <span asp-validation-for="ImageFile" class="text-danger small mt-1 d-block"></span>

                <div class="mt-3 text-center @(string.IsNullOrWhiteSpace(Model.ExistingImageUrl) ? "d-none" : "")" id="previewContainer">
                    <p class="small text-muted mb-1">معاينة الصورة:</p>
                    <img id="productCatImgPreview" src="@Model.ExistingImageUrl" alt="معاينة" class="rounded border shadow-sm object-fit-cover" style="width: 110px; height: 110px;">
                </div>
            </div>

            <div class="mb-4 form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch">
                <label asp-for="IsActive" class="form-check-label fw-bold">التصنيف نشط ويظهر في المنصة</label>
            </div>

            <hr class="mb-4">

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4 fw-bold"><i class="fa-solid fa-save ms-1"></i>حفظ البيانات</button>
                <a href="/dashboard/product-categories" class="btn btn-outline-secondary px-3">إلغاء</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function previewImage(input, targetId) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    $('#' + targetId).attr('src', e.target.result);
                    $('#previewContainer').removeClass('d-none');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
