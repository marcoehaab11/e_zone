@model SupplierDirectory.Application.ProductCategoryListViewModel
@{
    ViewData["Title"] = "إدارة تصنيفات المنتجات";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="fa-solid fa-tags text-primary me-2"></i>إدارة تصنيفات المنتجات</h3>
        <p class="text-muted small mb-0">تنظيم وهيكلة تصنيفات وأقسام المنتجات الرئيسية والفرعية</p>
    </div>
    <a href="/dashboard/product-categories/create" class="btn btn-primary"><i class="fa-solid fa-plus ms-1"></i>إضافة تصنيف منتج</a>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input name="Search" class="form-control border-start-0" value="@Model.Query.Search" placeholder="بحث باسم تصنيف المنتج أو الوصف...">
                </div>
            </div>
            <div class="col-md-4">
                <select name="ParentId" class="form-select">
                    <option value="">-- كل المستويات والتصنيفات --</option>
                    <option value="0" selected="@(Model.Query.ParentId == 0)">التصنيفات الرئيسية فقط</option>
                    @foreach (var parent in Model.Parents)
                    {
                        <option value="@parent.Id" selected="@(Model.Query.ParentId == parent.Id)">تحت: @parent.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary w-100"><i class="fa-solid fa-filter ms-1"></i>تصفية</button>
                @if (!string.IsNullOrWhiteSpace(Model.Query.Search) || Model.Query.ParentId.HasValue)
                {
                    <a href="/dashboard/product-categories" class="btn btn-outline-secondary" title="إعادة تعيين"><i class="fa-solid fa-rotate-left"></i></a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 80px;">الصورة</th>
                        <th>اسم التصنيف</th>
                        <th>المستوى</th>
                        <th>المنتجات</th>
                        <th>الوصف</th>
                        <th>الحالة</th>
                        <th class="text-end pe-4">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Name" class="rounded border shadow-sm object-fit-cover" style="width: 48px; height: 48px;">
                                    }
                                    else
                                    {
                                        <div class="rounded bg-light text-muted d-flex align-items-center justify-content-center border" style="width: 48px; height: 48px;">
                                            <i class="fa-solid fa-tag fa-lg opacity-50"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold text-dark fs-6">@item.Name</div>
                                    <small class="text-muted">أضيف في: @item.CreatedAt.ToString("yyyy-MM-dd")</small>
                                </td>
                                <td>
                                    @if (item.ParentCategoryId.HasValue)
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                                            <i class="fa-solid fa-arrow-turn-down-left me-1"></i>فرعي من: @item.ParentName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                            <i class="fa-solid fa-folder me-1"></i>تصنيف رئيسي
                                            @if (item.SubCategoriesCount > 0)
                                            {
                                                <span class="badge bg-primary ms-1">@item.SubCategoriesCount</span>
                                            }
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">
                                        <i class="fa-solid fa-box-open me-1"></i>@item.ProductsCount منتج
                                    </span>
                                </td>
                                <td>
                                    <span class="text-muted small text-truncate d-inline-block" style="max-width: 250px;">
                                        @(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)
                                    </span>
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success"><i class="fa-solid fa-circle-check me-1"></i>نشط</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary"><i class="fa-solid fa-circle-xmark me-1"></i>معطل</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a href="/dashboard/product-categories/@item.Id/edit" class="btn btn-sm btn-outline-primary" title="تعديل"><i class="fa-solid fa-pen-to-square"></i></a>
                                        
                                        <form method="post" action="/dashboard/product-categories/@item.Id/toggle" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-warning" : "btn-outline-success")" title="@(item.IsActive ? "تعطيل" : "تفعيل")">
                                                <i class="fa-solid @(item.IsActive ? "fa-ban" : "fa-check")"></i>
                                            </button>
                                        </form>
                                        
                                        <form method="post" action="/dashboard/product-categories/@item.Id/delete" class="m-0" onsubmit="return confirm('هل أنت متأكد من حذف هذا التصنيف؟');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف"><i class="fa-solid fa-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted p-5">
                                <i class="fa-solid fa-box-open fs-2 mb-2 d-block opacity-50"></i>
                                لا توجد تصنيفات منتجات مطابقة للبحث
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white p-3">
            <nav>
                <ul class="pagination mb-0 justify-content-center">
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Query.Page ? "active" : "")">
                            <a class="page-link" href="?Page=@p&Search=@Model.Query.Search&ParentId=@Model.Query.ParentId">@p</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>
