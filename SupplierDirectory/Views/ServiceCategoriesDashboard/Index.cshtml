@model IEnumerable<SupplierDirectory.Domain.ServiceCategory>
@{ ViewData["Title"]="تصنيفات الخدمات"; var q = ViewBag.Query as SupplierDirectory.Application.PageQuery; var pages=(int)ViewBag.TotalPages; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><h3 class="fw-bold mb-1"><i class="fa-solid fa-tags text-primary me-2"></i>تصنيفات خدماتنا</h3><p class="text-muted small mb-0">تصنيفات مستقلة لتنظيم الخدمات المعروضة في المنصة.</p></div><a href="/dashboard/service-categories/create" class="btn btn-primary rounded-pill px-4">إضافة تصنيف</a></div>
<div class="card shadow-sm border-0 rounded-4 mb-4"><div class="card-body"><form method="get" class="row g-3"><div class="col-md-9"><input class="form-control" name="Search" value="@q?.Search" placeholder="ابحث باسم أو وصف التصنيف"></div><div class="col-md-3 d-grid"><button class="btn btn-secondary rounded-pill">بحث</button></div></form></div></div>
<div class="card shadow-sm border-0 rounded-4"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th class="ps-4">التصنيف</th><th>الوصف</th><th>الخدمات</th><th>الحالة</th><th class="text-end pe-4">إجراءات</th></tr></thead><tbody>@foreach(var category in Model){<tr><td class="ps-4 fw-bold">@category.Name</td><td>@(category.Description ?? "—")</td><td><span class="badge bg-secondary-subtle text-secondary">@category.Services.Count خدمة</span></td><td><span class="badge @(category.IsActive ? "bg-success" : "bg-secondary")">@(category.IsActive ? "نشط" : "معطل")</span></td><td class="text-end pe-4"><div class="d-flex gap-2 justify-content-end"><a class="btn btn-sm btn-outline-primary rounded-pill" href="/dashboard/service-categories/@category.Id/edit">تعديل</a><form method="post" action="/dashboard/service-categories/@category.Id/toggle">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-warning rounded-pill">@(category.IsActive?"تعطيل":"تفعيل")</button></form><form method="post" action="/dashboard/service-categories/@category.Id/delete" onsubmit="return confirm('هل تريد حذف التصنيف؟')">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger rounded-pill">حذف</button></form></div></td></tr>}@if(!Model.Any()){<tr><td colspan="5" class="text-center text-muted py-5">لا توجد تصنيفات خدمات حتى الآن</td></tr>}</tbody></table></div>@if(pages>1){<div class="card-footer bg-white"><nav><ul class="pagination justify-content-center mb-0">@for(var p=1;p<=pages;p++){<li class="page-item @(p==q?.Page?"active":"")"><a class="page-link" href="?Page=@p&Search=@q?.Search">@p</a></li>}</ul></nav></div>}</div>
