@model IEnumerable<SupplierDirectory.Domain.Category>
@{
    ViewData["Title"] = "إدارة التصنيفات";
    var search = ViewBag.Search as string;
    var pageNum = (int)ViewBag.Page;
    var totalPages = (int)ViewBag.TotalPages;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0"><i class="fa-solid fa-layer-group me-2"></i>إدارة التصنيفات</h3>
    <a href="/dashboard/categories-list/create" class="btn btn-primary"><i class="fa-solid fa-plus ms-1"></i>إضافة تصنيف</a>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input name="search" class="form-control border-start-0" value="@search" placeholder="بحث باسم التصنيف أو الوصف...">
                </div>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-secondary w-100"><i class="fa-solid fa-filter ms-1"></i>تصفية</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">اسم التصنيف</th>
                        <th>الوصف</th>
                        <th>الحالة</th>
                        <th class="text-end pe-4">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any()) {
                        foreach(var item in Model) {
                            <tr>
                                <td class="ps-4 fw-bold">@item.Name</td>
                                <td class="text-muted">@item.Description</td>
                                <td>
                                    @if(item.IsActive) {
                                        <span class="badge bg-success">نشط</span>
                                    } else {
                                        <span class="badge bg-secondary">غير نشط</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a href="/dashboard/categories-list/@item.Id/edit" class="btn btn-sm btn-outline-primary" title="تعديل"><i class="fa-solid fa-pen-to-square"></i></a>
                                        
                                        <form method="post" action="/dashboard/categories-list/@item.Id/toggle" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-warning" : "btn-outline-success")" title="@(item.IsActive ? "تعطيل" : "تفعيل")">
                                                <i class="fa-solid @(item.IsActive ? "fa-ban" : "fa-check")"></i>
                                            </button>
                                        </form>
                                        
                                        <form method="post" action="/dashboard/categories-list/@item.Id/delete" class="m-0" onsubmit="return confirm('هل أنت متأكد من حذف هذا التصنيف؟');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف"><i class="fa-solid fa-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    } else {
                        <tr>
                            <td colspan="4" class="text-center text-muted p-4">لا توجد تصنيفات لعرضها</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    @if (totalPages > 1) {
        <div class="card-footer bg-white p-3">
            <nav>
                <ul class="pagination mb-0 justify-content-center">
                    @for(var p = 1; p <= totalPages; p++) {
                        <li class="page-item @(p == pageNum ? "active" : "")">
                            <a class="page-link" href="?page=@p&search=@search">@p</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>
