@{ Layout=null; var rows=(IEnumerable<SupplierDirectory.Controllers.ManagementRow>)ViewBag.Rows; string type=ViewBag.Type; }
<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><link rel="stylesheet" href="/css/site.css"><title>@ViewBag.Title</title></head><body><aside><h2>دليل الموردين</h2><a href="/">الرئيسية</a><a href="/dashboard/suppliers">الموردون</a><a href="/dashboard/areas">المناطق</a><a href="/dashboard/categories">التصنيفات</a><a href="/dashboard/advertisements">الإعلانات</a></aside><main class="dashboard"><h1>@ViewBag.Title</h1><section class="panel"><h2>إضافة جديد</h2><form method="post" action="/dashboard/manage">@Html.AntiForgeryToken()<input type="hidden" name="Type" value="@type"><label>الاسم <input name="Name" required></label><label>الوصف <input name="Description"></label><label><input type="checkbox" name="IsActive" value="true" checked> نشط</label><button>حفظ</button></form></section><section class="panel"><table><thead><tr><th>الاسم</th><th>الوصف</th><th>الحالة</th><th>إجراء</th></tr></thead><tbody>@foreach(var row in rows){<tr><td>@row.Name</td><td>@row.Description</td><td>@(row.IsActive?"نشط":"غير نشط")</td><td><form method="post" action="/dashboard/manage/delete">@Html.AntiForgeryToken()<input type="hidden" name="type" value="@type"><input type="hidden" name="id" value="@row.Id"><button onclick="return confirm('هل تريد الحذف؟')">حذف</button></form></td></tr>}</tbody></table></section></main></body></html>
