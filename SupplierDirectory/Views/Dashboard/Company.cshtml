@model SupplierDirectory.Application.CompanyFormViewModel
@{
    ViewData["Title"] = "معلومات الشركة";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0"><i class="fa-solid fa-building me-2"></i>معلومات الشركة والمنصة</h3>
</div>

<div class="card border-0 shadow-sm mb-5">
    <div class="card-body p-4">
        <form method="post" enctype="multipart/form-data" action="/dashboard/company">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="Id">
            <input type="hidden" asp-for="LogoUrl">
            <input type="hidden" asp-for="CoverImageUrl">

            <div class="row">
                <!-- Company Basics -->
                <div class="col-md-6 mb-4">
                    <h5 class="fw-bold text-primary border-bottom pb-2 mb-3">البيانات الأساسية</h5>
                    
                    <div class="mb-3">
                        <label asp-for="CompanyName" class="form-label fw-bold">اسم الشركة / المنصة</label>
                        <input asp-for="CompanyName" class="form-control">
                        <span asp-validation-for="CompanyName" class="text-danger small mt-1 d-block"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">شعار الشركة (Logo)</label>
                        <input type="file" asp-for="LogoFile" class="form-control" accept="image/*">
                        <span asp-validation-for="LogoFile" class="text-danger small mt-1 d-block"></span>
                        @if(!string.IsNullOrEmpty(Model.LogoUrl)) {
                            <div class="mt-2">
                                <img src="@Model.LogoUrl" alt="شعار" class="img-thumbnail" style="max-height: 80px;">
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">صور الغلاف (Cover Images) <span class="text-muted fw-normal small">(يمكنك اختيار أكثر من صورة)</span></label>
                        <input type="file" asp-for="NewCoverImages" class="form-control" multiple accept="image/*">
                        <span asp-validation-for="NewCoverImages" class="text-danger small mt-1 d-block"></span>
                        <div class="form-text small text-muted">يمكنك تحديد عدة صور لعرضها كغلاف للمنصة (مثل السلايدر أو المعرض).</div>
                        
                        @if(Model.ExistingCoverImages != null && Model.ExistingCoverImages.Any()) {
                            <div class="mt-3">
                                <label class="form-label fw-bold small text-muted">صور الغلاف الحالية:</label>
                                <div class="row g-2">
                                    @foreach(var cover in Model.ExistingCoverImages) {
                                        <div class="col-4 col-md-3 text-center" id="cover-img-@cover.Id">
                                            <div class="position-relative d-inline-block border rounded p-1 shadow-sm bg-light w-100">
                                                <img src="@cover.ImageUrl" alt="غلاف" class="img-fluid rounded" style="height: 80px; width: 100%; object-fit: cover;">
                                                <button type="button" class="btn btn-danger btn-sm position-absolute top-0 start-0 translate-middle rounded-circle shadow" onclick="deleteCoverImg(@cover.Id)" title="حذف صورة الغلاف"><i class="fa-solid fa-xmark"></i></button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        } else if(!string.IsNullOrEmpty(Model.CoverImageUrl)) {
                            <div class="mt-2">
                                <img src="@Model.CoverImageUrl" alt="غلاف" class="img-thumbnail" style="max-height: 100px;">
                            </div>
                        }
                    </div>
                </div>

                <!-- Contact & Social -->
                <div class="col-md-6 mb-4">
                    <h5 class="fw-bold text-primary border-bottom pb-2 mb-3">بيانات التواصل</h5>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ContactPhone" class="form-label fw-bold">الهاتف</label>
                            <input asp-for="ContactPhone" class="form-control" dir="ltr">
                            <span asp-validation-for="ContactPhone" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="WhatsApp" class="form-label fw-bold">الواتساب</label>
                            <input asp-for="WhatsApp" class="form-control" dir="ltr">
                            <span asp-validation-for="WhatsApp" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold">البريد الإلكتروني</label>
                        <input asp-for="Email" type="email" class="form-control" dir="ltr">
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Website" class="form-label fw-bold">الموقع الإلكتروني</label>
                        <input asp-for="Website" type="url" class="form-control" dir="ltr">
                        <span asp-validation-for="Website" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <!-- About & Description -->
                <div class="col-md-12 mb-4">
                    <h5 class="fw-bold text-primary border-bottom pb-2 mb-3">من نحن ورؤية المنصة</h5>
                    
                    <div class="mb-3">
                        <label asp-for="About" class="form-label fw-bold">عن الشركة</label>
                        <textarea asp-for="About" class="form-control" rows="3"></textarea>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Mission" class="form-label fw-bold">رسالتنا (Mission)</label>
                            <textarea asp-for="Mission" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Vision" class="form-label fw-bold">رؤيتنا (Vision)</label>
                            <textarea asp-for="Vision" class="form-control" rows="3"></textarea>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PlatformDescription" class="form-label fw-bold">وصف المنصة</label>
                            <textarea asp-for="PlatformDescription" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PlatformServices" class="form-label fw-bold">خدمات المنصة</label>
                            <textarea asp-for="PlatformServices" class="form-control" rows="3"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <!-- Platform Links -->
                <div class="col-md-12 mb-4">
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                        <h5 class="fw-bold text-primary mb-0"><i class="fa-solid fa-link me-2"></i>الروابط العامة والإضافية</h5>
                        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="addLinkRow()">
                            <i class="fa-solid fa-plus me-1"></i> إضافة رابط جديد
                        </button>
                    </div>
                    
                    <div id="linksContainer" class="d-flex flex-column gap-2">
                        @for (int i = 0; i < Model.Links.Count; i++)
                        {
                            <div class="row g-2 align-items-center link-row p-2 border rounded bg-light">
                                <input type="hidden" name="Links[@i].Id" value="@Model.Links[i].Id" class="link-id" />
                                <div class="col-md-4">
                                    <div class="input-group">
                                        <span class="input-group-text bg-white"><i class="fa-solid fa-tag text-muted"></i></span>
                                        <input type="text" name="Links[@i].Title" value="@Model.Links[i].Title" class="form-control link-title" placeholder="عنوان الرابط (مثل: فيسبوك، سياسة الخصوصية...)" required />
                                    </div>
                                </div>
                                <div class="col-md-7">
                                    <div class="input-group">
                                        <span class="input-group-text bg-white"><i class="fa-solid fa-globe text-muted"></i></span>
                                        <input type="url" name="Links[@i].Url" value="@Model.Links[i].Url" class="form-control link-url" placeholder="الرابط (https://...)" dir="ltr" required />
                                    </div>
                                </div>
                                <div class="col-md-1 text-center">
                                    <button type="button" class="btn btn-outline-danger btn-sm rounded-circle p-2" onclick="removeLinkRow(this)" title="حذف الرابط">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                    <div id="noLinksMsg" class="text-muted small text-center p-3 border border-dashed rounded mt-2 @(Model.Links.Any() ? "d-none" : "")">
                        لا توجد روابط إضافية مضافة حالياً. اضغط على زر "إضافة رابط جديد" لإضافة روابط للمنصة.
                    </div>
                </div>
            </div>

            <div class="row mt-2">
                <!-- Platform Images -->
                <div class="col-md-12 mb-4">
                    <h5 class="fw-bold text-primary border-bottom pb-2 mb-3"><i class="fa-solid fa-images me-2"></i>صور المنصة (معرض الصور)</h5>
                    
                    <div class="mb-4">
                        <label asp-for="NewImages" class="form-label fw-bold">رفع صور جديدة للمنصة (يمكنك اختيار أكثر من صورة)</label>
                        <input type="file" asp-for="NewImages" class="form-control" multiple accept="image/*">
                        <span asp-validation-for="NewImages" class="text-danger small mt-1 d-block"></span>
                    </div>

                    @if (Model.ExistingImages != null && Model.ExistingImages.Any()) {
                        <h6 class="fw-bold mb-3">الصور الحالية:</h6>
                        <div class="row g-3">
                            @foreach(var img in Model.ExistingImages) {
                                <div class="col-6 col-md-3 col-lg-2 text-center" id="img-@img.Id">
                                    <div class="position-relative d-inline-block border rounded p-1 shadow-sm bg-light">
                                        <img src="@img.ImageUrl" class="img-fluid rounded" style="height:100px; width:100px; object-fit:cover;">
                                        <button type="button" class="btn btn-danger btn-sm position-absolute top-0 start-0 translate-middle rounded-circle shadow" onclick="deleteCompanyImg(@img.Id)"><i class="fa-solid fa-xmark"></i></button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
            
            <hr class="mb-4">
            
            <div class="text-center">
                <button type="submit" class="btn btn-primary btn-lg px-5 fw-bold"><i class="fa-solid fa-save ms-2"></i>حفظ المعلومات</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function reindexLinks() {
            const container = document.getElementById('linksContainer');
            const rows = container.querySelectorAll('.link-row');
            const noLinksMsg = document.getElementById('noLinksMsg');
            
            if (rows.length === 0) {
                if (noLinksMsg) noLinksMsg.classList.remove('d-none');
            } else {
                if (noLinksMsg) noLinksMsg.classList.add('d-none');
            }

            rows.forEach((row, index) => {
                const idInput = row.querySelector('.link-id');
                const titleInput = row.querySelector('.link-title');
                const urlInput = row.querySelector('.link-url');
                
                if (idInput) idInput.name = `Links[${index}].Id`;
                if (titleInput) titleInput.name = `Links[${index}].Title`;
                if (urlInput) urlInput.name = `Links[${index}].Url`;
            });
        }

        function addLinkRow(title = '', url = '') {
            const container = document.getElementById('linksContainer');
            const index = container.querySelectorAll('.link-row').length;
            
            const row = document.createElement('div');
            row.className = 'row g-2 align-items-center link-row p-2 border rounded bg-light mb-2';
            row.innerHTML = `
                <input type="hidden" name="Links[${index}].Id" value="0" class="link-id" />
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="fa-solid fa-tag text-muted"></i></span>
                        <input type="text" name="Links[${index}].Title" value="${title}" class="form-control link-title" placeholder="عنوان الرابط (مثل: فيسبوك، سياسة الخصوصية...)" required />
                    </div>
                </div>
                <div class="col-md-7">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="fa-solid fa-globe text-muted"></i></span>
                        <input type="url" name="Links[${index}].Url" value="${url}" class="form-control link-url" placeholder="الرابط (https://...)" dir="ltr" required />
                    </div>
                </div>
                <div class="col-md-1 text-center">
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-circle p-2" onclick="removeLinkRow(this)" title="حذف الرابط">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                </div>
            `;
            container.appendChild(row);
            reindexLinks();
        }

        function removeLinkRow(btn) {
            const row = btn.closest('.link-row');
            if (row) {
                row.remove();
                reindexLinks();
            }
        }

        function deleteCoverImg(imgId) {
            if(!confirm('هل أنت متأكد من حذف صورة الغلاف هذه؟')) return;
            fetch('/dashboard/company/delete-cover-image/' + imgId, {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json', 
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value 
                }
            }).then(r => { 
                if(r.ok) {
                    const el = document.getElementById('cover-img-' + imgId);
                    if(el) el.remove();
                } else {
                    alert('حدث خطأ أثناء حذف صورة الغلاف');
                }
            }).catch(e => {
                alert('حدث خطأ في الاتصال');
            });
        }

        function deleteCompanyImg(imgId) {
            if(!confirm('هل أنت متأكد من حذف هذه الصورة؟')) return;
            fetch('/dashboard/company/delete-image/' + imgId, {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json', 
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value 
                }
            }).then(r => { 
                if(r.ok) {
                    const el = document.getElementById('img-' + imgId);
                    if(el) el.remove();
                } else {
                    alert('حدث خطأ أثناء حذف الصورة');
                }
            }).catch(e => {
                alert('حدث خطأ في الاتصال');
            });
        }
    </script>
}
