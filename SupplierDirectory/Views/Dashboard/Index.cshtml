@{ var s=ViewBag.Stats; var suppliers=(IEnumerable<SupplierDirectory.Domain.Supplier>)ViewBag.Suppliers; Layout=null; }
<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>الرئيسية | دليل الموردين</title><link rel="stylesheet" href="/css/site.css"></head><body><aside><h2>دليل الموردين</h2><a href="/">الرئيسية</a><a href="/api/admin/suppliers">الموردون</a><a href="/api/admin/areas">المناطق</a><a href="/api/admin/categories">التصنيفات</a><a href="/api/admin/advertisements">الإعلانات</a><form action="/logout" method="post"><button class="link">تسجيل الخروج</button></form></aside><main class="dashboard"><h1>الرئيسية</h1><section class="cards"><article><b>@s.Suppliers</b>إجمالي الموردين</article><article><b>@s.ActiveSuppliers</b>الموردون النشطون</article><article><b>@s.Areas</b>إجمالي المناطق</article><article><b>@s.Categories</b>إجمالي التصنيفات</article><article><b>@s.Ads</b>إجمالي الإعلانات</article><article><b>@s.ActiveAds</b>الإعلانات النشطة</article></section><section class="panel"><h2>أحدث الموردين</h2><table><thead><tr><th>اسم المورد</th><th>الحالة</th><th>تاريخ الإضافة</th></tr></thead><tbody>@foreach(var x in suppliers){<tr><td>@x.Name</td><td>@(x.IsActive?"نشط":"غير نشط")</td><td>@x.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</td></tr>}</tbody></table></section></main></body></html>
