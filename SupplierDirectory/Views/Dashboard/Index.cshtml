@{
    ViewData["Title"] = "الرئيسية";
    var s = ViewBag.Stats;
    var recentSuppliers = ViewBag.Suppliers as IEnumerable<SupplierDirectory.Domain.Supplier>;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold text-dark">لوحة التحكم والإحصائيات</h3>
</div>

<div class="row g-4 mb-5">
    <!-- Suppliers Stat -->
    <div class="col-md-4 col-lg-3">
        <div class="card border-0 shadow-sm text-center p-3 h-100">
            <div class="card-body">
                <i class="fa-solid fa-users fs-1 text-primary mb-3"></i>
                <h5 class="card-title text-muted">إجمالي الموردين</h5>
                <h2 class="fw-bold mb-0">@s.Suppliers</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-3">
        <div class="card border-0 shadow-sm text-center p-3 h-100">
            <div class="card-body">
                <i class="fa-solid fa-user-check fs-1 text-success mb-3"></i>
                <h5 class="card-title text-muted">الموردون النشطون</h5>
                <h2 class="fw-bold mb-0">@s.ActiveSuppliers</h2>
            </div>
        </div>
    </div>
    
    <!-- Areas & Categories -->
    <div class="col-md-4 col-lg-3">
        <div class="card border-0 shadow-sm text-center p-3 h-100">
            <div class="card-body">
                <i class="fa-solid fa-map-location-dot fs-1 text-info mb-3"></i>
                <h5 class="card-title text-muted">إجمالي المناطق</h5>
                <h2 class="fw-bold mb-0">@s.Areas</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-3">
        <div class="card border-0 shadow-sm text-center p-3 h-100">
            <div class="card-body">
                <i class="fa-solid fa-layer-group fs-1 text-warning mb-3"></i>
                <h5 class="card-title text-muted">إجمالي التصنيفات</h5>
                <h2 class="fw-bold mb-0">@s.Categories</h2>
            </div>
        </div>
    </div>
    
    <!-- Ads -->
    <div class="col-md-4 col-lg-3">
        <div class="card border-0 shadow-sm text-center p-3 h-100">
            <div class="card-body">
                <i class="fa-solid fa-bullhorn fs-1 text-secondary mb-3"></i>
                <h5 class="card-title text-muted">إجمالي الإعلانات</h5>
                <h2 class="fw-bold mb-0">@s.Ads</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4 col-lg-3">
        <div class="card border-0 shadow-sm text-center p-3 h-100">
            <div class="card-body">
                <i class="fa-solid fa-bolt fs-1 text-danger mb-3"></i>
                <h5 class="card-title text-muted">الإعلانات النشطة</h5>
                <h2 class="fw-bold mb-0">@s.ActiveAds</h2>
            </div>
        </div>
    </div>
</div>

<!-- Recent Suppliers Table -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom p-3">
        <h5 class="mb-0 fw-bold"><i class="fa-solid fa-clock-rotate-left me-2"></i>أحدث الموردين المضافين</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">اسم المورد</th>
                        <th>الحالة</th>
                        <th>تاريخ الإضافة</th>
                    </tr>
                </thead>
                <tbody>
                    @if(recentSuppliers != null && recentSuppliers.Any()) {
                        foreach(var supplier in recentSuppliers) {
                            <tr>
                                <td class="ps-4 fw-bold">@supplier.Name</td>
                                <td>
                                    @if(supplier.IsActive) {
                                        <span class="badge bg-success">نشط</span>
                                    } else {
                                        <span class="badge bg-danger">غير نشط</span>
                                    }
                                </td>
                                <td>@supplier.CreatedAt.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    } else {
                        <tr>
                            <td colspan="3" class="text-center text-muted p-4">لا يوجد موردين مضافين حديثاً.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-white text-center p-3">
        <a href="/Dashboard/Suppliers" class="btn btn-outline-primary btn-sm">عرض كل الموردين <i class="fa-solid fa-arrow-left ms-1"></i></a>
    </div>
</div>
