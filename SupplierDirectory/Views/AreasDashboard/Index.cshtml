@model SupplierDirectory.Application.AreaListViewModel
@{Layout=null;}
<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/css/site.css"><title>إدارة المناطق</title></head><body><aside><h2>دليل الموردين</h2><a href="/">الرئيسية</a><a href="/dashboard/suppliers">الموردون</a><a class="active" href="/dashboard/areas">المناطق</a><a href="/dashboard/categories">التصنيفات</a><a href="/dashboard/advertisements">الإعلانات</a></aside><main class="dashboard"><div class="page-head"><div><h1>إدارة المناطق</h1><p>دولة ← محافظة ← مدينة ← منطقة</p></div><a class="button" href="/dashboard/areas/create">إضافة منطقة</a></div>@if(TempData["Success"] is string success){<p class="notice success">@success</p>}@if(TempData["Error"] is string error){<p class="notice error">@error</p>}<section class="panel"><form class="filters" method="get"><input name="search" value="@Model.Query.Search" placeholder="بحث بالاسم أو الوصف"><select name="parentId"><option value="">كل المستويات</option>@foreach(var p in Model.Parents){<option value="@p.Id" selected="@(Model.Query.ParentId==p.Id)">@p.Name</option>}</select><button>بحث</button></form><table><thead><tr><th>المنطقة</th><th>الأم</th><th>الوصف</th><th>الحالة</th><th>إجراء</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.Name</td><td>@(x.ParentName??"—")</td><td>@x.Description</td><td>@(x.IsActive?"نشطة":"موقوفة")</td><td class="actions"><a href="/dashboard/areas/@x.Id/edit">تعديل</a><form method="post" action="/dashboard/areas/@x.Id/toggle">@Html.AntiForgeryToken()<button>@(x.IsActive?"تعطيل":"تفعيل")</button></form><form method="post" action="/dashboard/areas/@x.Id/delete" onsubmit="return confirm('حذف المنطقة؟')">@Html.AntiForgeryToken()<button>حذف</button></form></td></tr>}</tbody></table><div class="pagination">@for(var pageNumber=1;pageNumber<=Model.TotalPages;pageNumber++){<a href="?page=@pageNumber&amp;pageSize=@Model.Query.PageSize&amp;search=@Model.Query.Search&amp;parentId=@Model.Query.ParentId">@pageNumber</a>}</div></section></main></body></html>
