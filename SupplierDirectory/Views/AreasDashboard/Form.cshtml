@model SupplierDirectory.Application.AreaFormViewModel
@{Layout=null;var editing=Model.Id.HasValue;}
<!doctype html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><link rel="stylesheet" href="/css/site.css"><title>@(editing?"تعديل منطقة":"إضافة منطقة")</title></head><body><main class="dashboard"><div class="page-head"><h1>@(editing?"تعديل منطقة":"إضافة منطقة")</h1><a href="/dashboard/areas">رجوع</a></div><section class="panel form-panel"><form method="post" action="@(editing?$"/dashboard/areas/{Model.Id}/edit":"/dashboard/areas/create")">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly"></div><label>اسم المنطقة<input asp-for="Name"></label><span asp-validation-for="Name"></span><label>الوصف<textarea asp-for="Description"></textarea></label><label>المنطقة الأم<select asp-for="ParentAreaId"><option value="">مستوى رئيسي</option>@foreach(var p in Model.Parents){<option value="@p.Id">@p.Name</option>}</select></label><label><input asp-for="IsActive"> نشطة</label><button class="button">حفظ</button></form></section></main></body></html>
