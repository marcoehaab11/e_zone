@using System.Globalization
@inject SupplierDirectory.Infrastructure.Localization.IUiText T
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" dir="@(T.IsEnglish ? "ltr" : "rtl")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Power Zone</title>
    @if (T.IsEnglish)
    {
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    }
    else
    {
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    }
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <!-- Custom Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml">
</head>
<body data-dashboard-language="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <div id="sidebar-wrapper">
            <div class="sidebar-heading text-center fw-bold fs-5">
                <i class="fa-solid fa-users-gear me-2"></i> Power Zone
            </div>
            
            <div class="list-group list-group-flush mt-3" id="sidebarMenu">
                <a href="/dashboard" class="list-group-item sidebar-link">
                    <i class="fa-solid fa-house"></i> @T.Get("الرئيسية", "Dashboard")
                </a>
                
                <!-- Suppliers -->
                <a href="#suppliersSubmenu" data-bs-toggle="collapse" class="list-group-item sidebar-link has-submenu d-flex justify-content-between align-items-center">
                    <div><i class="fa-solid fa-users"></i> @T.Get("إدارة الموردين", "Suppliers")</div>
                    <i class="fa-solid fa-chevron-down chevron-icon"></i>
                </a>
                <div class="collapse sidebar-submenu" id="suppliersSubmenu" data-bs-parent="#sidebarMenu">
                    <a href="/dashboard/suppliers" class="list-group-item sidebar-link">@T.Get("قائمة الموردين", "Supplier list")</a>
                    <a href="/dashboard/suppliers/create" class="list-group-item sidebar-link">@T.Get("إضافة مورد جديد", "Add supplier")</a>
                </div>

                <!-- Areas -->
                <a href="#areasSubmenu" data-bs-toggle="collapse" class="list-group-item sidebar-link has-submenu d-flex justify-content-between align-items-center">
                    <div><i class="fa-solid fa-map-location-dot"></i> @T.Get("إدارة المناطق", "Areas")</div>
                    <i class="fa-solid fa-chevron-down chevron-icon"></i>
                </a>
                <div class="collapse sidebar-submenu" id="areasSubmenu" data-bs-parent="#sidebarMenu">
                    <a href="/dashboard/areas" class="list-group-item sidebar-link">المناطق المتاحة</a>
                    <a href="/dashboard/areas/create" class="list-group-item sidebar-link">إضافة منطقة</a>
                </div>

                <!-- Supplier Categories -->
                <a href="#supplierCatsSubmenu" data-bs-toggle="collapse" class="list-group-item sidebar-link has-submenu d-flex justify-content-between align-items-center">
                    <div><i class="fa-solid fa-layer-group"></i> تصنيفات الموردين</div>
                    <i class="fa-solid fa-chevron-down chevron-icon"></i>
                </a>
                <div class="collapse sidebar-submenu" id="supplierCatsSubmenu" data-bs-parent="#sidebarMenu">
                    <a href="/dashboard/categories-list" class="list-group-item sidebar-link">قائمة تصنيفات الموردين</a>
                    <a href="/dashboard/categories-list/create" class="list-group-item sidebar-link">إضافة تصنيف مورد</a>
                </div>

                <!-- Product Categories -->
                <a href="#productCatsSubmenu" data-bs-toggle="collapse" class="list-group-item sidebar-link has-submenu d-flex justify-content-between align-items-center">
                    <div><i class="fa-solid fa-tags"></i> تصنيفات المنتجات</div>
                    <i class="fa-solid fa-chevron-down chevron-icon"></i>
                </a>
                <div class="collapse sidebar-submenu" id="productCatsSubmenu" data-bs-parent="#sidebarMenu">
                    <a href="/dashboard/product-categories" class="list-group-item sidebar-link">قائمة تصنيفات المنتجات</a>
                    <a href="/dashboard/product-categories/create" class="list-group-item sidebar-link">إضافة تصنيف منتج</a>
                </div>

                <!-- Products -->
                <a href="#productsSubmenu" data-bs-toggle="collapse" class="list-group-item sidebar-link has-submenu d-flex justify-content-between align-items-center">
                    <div><i class="fa-solid fa-box-open"></i> إدارة المنتجات</div>
                    <i class="fa-solid fa-chevron-down chevron-icon"></i>
                </a>
                <div class="collapse sidebar-submenu" id="productsSubmenu" data-bs-parent="#sidebarMenu">
                    <a href="/dashboard/products" class="list-group-item sidebar-link">قائمة المنتجات</a>
                    <a href="/dashboard/products/create" class="list-group-item sidebar-link">إضافة منتج</a>
                </div>

                <!-- Services -->
                <a href="#servicesSubmenu" data-bs-toggle="collapse" class="list-group-item sidebar-link has-submenu d-flex justify-content-between align-items-center">
                    <div><i class="fa-solid fa-screwdriver-wrench"></i> @T.Get("إدارة خدماتنا", "Our services")</div>
                    <i class="fa-solid fa-chevron-down chevron-icon"></i>
                </a>
                <div class="collapse sidebar-submenu" id="servicesSubmenu" data-bs-parent="#sidebarMenu">
                    <a href="/dashboard/services" class="list-group-item sidebar-link">@T.Get("قائمة الخدمات", "Service list")</a>
                    <a href="/dashboard/services/create" class="list-group-item sidebar-link">@T.Get("إضافة خدمة", "Add service")</a>
                    <a href="/dashboard/service-categories" class="list-group-item sidebar-link">@T.Get("تصنيفات الخدمات", "Service categories")</a>
                    <a href="/dashboard/service-categories/create" class="list-group-item sidebar-link">@T.Get("إضافة تصنيف خدمة", "Add service category")</a>
                </div>

                <!-- Ads -->
                <a href="#adsSubmenu" data-bs-toggle="collapse" class="list-group-item sidebar-link has-submenu d-flex justify-content-between align-items-center">
                    <div><i class="fa-solid fa-bullhorn"></i> إدارة الإعلانات</div>
                    <i class="fa-solid fa-chevron-down chevron-icon"></i>
                </a>
                <div class="collapse sidebar-submenu" id="adsSubmenu" data-bs-parent="#sidebarMenu">
                    <a href="/dashboard/ads" class="list-group-item sidebar-link">الإعلانات</a>
                    <a href="/dashboard/ads/create" class="list-group-item sidebar-link">إضافة إعلان</a>
                </div>

                <!-- Company Info -->
                <a href="/dashboard/company" class="list-group-item sidebar-link border-top border-secondary pt-3">
                    <i class="fa-solid fa-building"></i> معلومات المنصة
                </a>

                <!-- Users -->
                <a href="/dashboard/users" class="list-group-item sidebar-link">
                    <i class="fa-solid fa-users-cog"></i> إدارة المستخدمين
                </a>

                <form method="post" action="/culture/set" class="m-0 px-3 py-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                    <input type="hidden" name="culture" value="@(T.IsEnglish ? "ar" : "en")" />
                    <button type="submit" class="btn btn-outline-light btn-sm w-100">@(T.IsEnglish ? "العربية" : "English")</button>
                </form>

                <!-- Sidebar Logout -->
                <form method="post" action="/logout" class="m-0 mt-auto border-top border-secondary">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="list-group-item sidebar-link text-danger w-100 text-start">
                        <i class="fa-solid fa-right-from-bracket"></i> تسجيل الخروج
                    </button>
                </form>
            </div>
        </div>
        
        <!-- Sidebar Overlay for mobile -->
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <!-- Page Content -->
        <div id="page-content-wrapper">
            <nav class="navbar navbar-expand-lg navbar-light bg-white p-3 shadow-sm d-flex justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-outline-secondary d-md-none" id="menu-toggle"><i class="fa-solid fa-bars"></i></button>
                    <h4 class="m-0 text-primary fw-bold d-none d-md-block">@ViewData["Title"]</h4>
                </div>
                
                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center bg-light px-3 py-1 rounded-pill border">
                        <i class="fa-solid fa-user-circle fs-4 text-primary ms-2"></i>
                        <span class="fw-bold text-secondary">@User.Identity?.Name</span>
                    </div>
                    <form method="post" action="/logout" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                            <i class="fa-solid fa-right-from-bracket ms-1"></i> خروج
                        </button>
                    </form>
                </div>
            </nav>

            <div class="container-fluid p-4">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                        <i class="fa-solid fa-circle-check ms-2"></i>
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                        <i class="fa-solid fa-circle-exclamation ms-2"></i>
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/dashboard-i18n.js" asp-append-version="true"></script>
    
    <script>
        $(document).ready(function () {
            // Toggle sidebar on mobile
            $("#menu-toggle").click(function(e) {
                e.preventDefault();
                $("#wrapper").toggleClass("toggled");
            });

            // Close sidebar when clicking overlay on mobile
            $("#sidebarOverlay").click(function() {
                $("#wrapper").removeClass("toggled");
            });

            // Active menu link logic
            var currentPath = window.location.pathname.toLowerCase();
            
            // Expand parent collapse if a child is active
            $('.sidebar-submenu .sidebar-link').each(function () {
                var href = $(this).attr('href').toLowerCase();
                // Check if current path matches href EXACTLY or starts with it (for edit/create)
                if (currentPath === href || (currentPath.startsWith(href) && href !== '/dashboard' && href !== '/')) {
                    $(this).addClass('active');
                    $(this).closest('.collapse').addClass('show');
                    $(this).closest('.collapse').prev('.has-submenu').attr('aria-expanded', 'true');
                }
            });

            // Top level links active state
            $('.list-group > .sidebar-link:not(.has-submenu)').each(function () {
                var href = $(this).attr('href').toLowerCase();
                if (currentPath === href || (currentPath === '/' && href === '/dashboard')) {
                    $(this).addClass('active');
                }
            });
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>




